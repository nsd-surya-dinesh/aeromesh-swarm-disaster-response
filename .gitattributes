# Force LF for source code (Linux judges)
*.py text eol=lf
*.sh text eol=lf
*.xml text eol=lf
*.cfg text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Windows-only files
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.zip binary
*.tar.gz binary
